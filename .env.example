# Скопируй этот файл в .env и заполни значения. Сам .env в git не попадает.

# Cookie golden_key с funpay.com (DevTools -> Application -> Cookies -> golden_key).
GOLDEN_KEY=

# User-Agent ТОГО ЖЕ браузера, из которого взят golden_key.
# Если они не совпадают, FunPay разлогинивает сессию.
USER_AGENT=

# ID категории (ИГРЫ), лоты которой поднимаем. Не путать с подкатегорией:
# 123 = PUBG Mobile (подкатегория «Аккаунты PUBG Mobile» — 346).
CATEGORY_ID=123

# Необязательные настройки автоподнятия (значения ниже — умолчания).
# Как часто обновлять сессию через account.get(), минуты.
SESSION_REFRESH_MINUTES=40
# Сколько спать, если FunPay не сообщил время кулдауна, минуты.
DEFAULT_COOLDOWN_MINUTES=30
# Пауза перед повтором после сетевой ошибки, минуты.
ERROR_RETRY_MINUTES=2

# --- Telegram-управление (необязательно; без него бот работает, просто без пульта) ---
# Токен бота от @BotFather.
TG_TOKEN=
# Твой числовой id в Telegram — его отдаёт @userinfobot. Бот отвечает только на него.
TG_ADMIN_ID=
